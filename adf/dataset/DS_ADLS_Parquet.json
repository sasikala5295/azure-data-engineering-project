{
	"name": "DS_ADLS_Parquet",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS_Gen2",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"p_TableName": {
				"type": "string"
			},
			"p_LoadDate": {
				"type": "string"
			},
			"p_FileName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().p_FileName",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat(dataset().p_TableName,'/',dataset().p_LoadDate)",
					"type": "Expression"
				},
				"fileSystem": "raw"
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}